{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/baseline-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseline_id", "source_kind", "generator_revision", "fork_params_sha256", "weights_sha256", "evidence_artifacts", "owner_attestation", "allowed_claim_scope", "claim_template_id", "protocol_lock_sha256"],
        "properties": {
          "baseline_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"},
          "source_kind": {"enum": ["original_tuningdriver", "geko_gfx942_proxy"]},
          "generator_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "fork_params_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "weights_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/definitions/evidence"}
          },
          "owner_attestation": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/definitions/path_hash"}
            ]
          },
          "allowed_claim_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["observability_only", "development_comparison", "final_comparison"]}
          },
          "claim_template_id": {"enum": ["original-tuningdriver-v1", "geko-proxy-v1"]},
          "protocol_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"source_kind": {"const": "original_tuningdriver"}}},
            "then": {
              "properties": {
                "owner_attestation": {"$ref": "#/definitions/path_hash"},
                "claim_template_id": {"const": "original-tuningdriver-v1"}
              }
            },
            "else": {
              "properties": {
                "owner_attestation": {"type": "null"},
                "claim_template_id": {"const": "geko-proxy-v1"}
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\-/]+$"},
    "path_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/definitions/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "evidence_type"],
      "properties": {
        "path": {"$ref": "#/definitions/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_type": {"enum": ["raw_artifact", "owner_attestation", "generator_manifest", "tuningdriver_artifact", "tuningdriver_manifest"]}
      }
    }
  }
}
