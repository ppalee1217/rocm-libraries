{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "complete", "generations_started", "generations_finished", "proposed_candidates", "valid_unique", "terminal_counts", "compile_attempts", "compile_failures", "benchmark_attempts", "benchmark_failures", "subprocess_invocations", "subprocess_failures", "candidate_shape_samples", "ductile_legacy_positive_candidate_evals", "complete_candidate_evals", "partial_candidate_evals", "partial_positive_candidate_evals", "checkpoint_count", "checkpoint_generation", "final_generation", "f_avg_sequence", "f_max_sequence", "population_size_sequence", "decay_mode_sequence", "diversity_sequence", "champion_hash", "champion_fitness_sha256", "termination_reason", "stage_timing_ns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "complete": {"const": true},
    "generations_started": {"type": "integer", "minimum": 1},
    "generations_finished": {"type": "integer", "minimum": 1},
    "proposed_candidates": {"type": "integer", "minimum": 1},
    "valid_unique": {"type": "integer", "minimum": 0},
    "terminal_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalid", "duplicate", "compile_failed", "benchmark_failed", "partial", "complete"],
      "properties": {
        "invalid": {"type": "integer", "minimum": 0},
        "duplicate": {"type": "integer", "minimum": 0},
        "compile_failed": {"type": "integer", "minimum": 0},
        "benchmark_failed": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0}
      }
    },
    "compile_attempts": {"type": "integer", "minimum": 0},
    "compile_failures": {"type": "integer", "minimum": 0},
    "benchmark_attempts": {"type": "integer", "minimum": 0},
    "benchmark_failures": {"type": "integer", "minimum": 0},
    "subprocess_invocations": {"type": "integer", "minimum": 0},
    "subprocess_failures": {"type": "integer", "minimum": 0},
    "candidate_shape_samples": {"type": "integer", "minimum": 1},
    "ductile_legacy_positive_candidate_evals": {"type": "integer", "minimum": 0},
    "complete_candidate_evals": {"type": "integer", "minimum": 0},
    "partial_candidate_evals": {"type": "integer", "minimum": 0},
    "partial_positive_candidate_evals": {"type": "integer", "minimum": 0},
    "checkpoint_count": {"type": "integer", "minimum": 1},
    "checkpoint_generation": {"type": "integer", "minimum": 1},
    "final_generation": {"type": "integer", "minimum": 1},
    "f_avg_sequence": {"$ref": "#/definitions/number_sequence"},
    "f_max_sequence": {"$ref": "#/definitions/number_sequence"},
    "population_size_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "decay_mode_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["none", "large_space", "low_diversity"]}
    },
    "diversity_sequence": {"$ref": "#/definitions/number_sequence"},
    "champion_hash": {"$ref": "#/definitions/sha"},
    "champion_fitness_sha256": {"$ref": "#/definitions/sha"},
    "termination_reason": {"enum": ["fixed_horizon", "early_stop", "ledger_complete"]},
    "stage_timing_ns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile", "benchmark", "subprocess"],
      "properties": {
        "compile": {"type": "integer", "minimum": 0},
        "benchmark": {"type": "integer", "minimum": 0},
        "subprocess": {"type": "integer", "minimum": 0}
      }
    }
  },
  "definitions": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "number_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    }
  }
}
