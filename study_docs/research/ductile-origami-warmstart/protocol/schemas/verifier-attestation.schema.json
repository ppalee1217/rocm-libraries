{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/verifier-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issuer_role", "issuer", "issued_at", "overall", "source_set_sha256", "contract_sha256", "effective_contract_sha256", "protocol_lock_sha256", "run_root", "bundle_checksum_manifest_sha256", "differential_summary_sha256", "criteria", "criterion_evidence", "root_causes", "required_fixes", "evidence_gaps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "issuer_role": {"enum": ["implementer-self-check", "independent-verifier"]},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "overall": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
    "source_set_sha256": {"$ref": "#/definitions/sha"},
    "contract_sha256": {"$ref": "#/definitions/sha"},
    "effective_contract_sha256": {"$ref": "#/definitions/sha"},
    "protocol_lock_sha256": {"$ref": "#/definitions/sha"},
    "run_root": {"type": "string", "pattern": "^/"},
    "bundle_checksum_manifest_sha256": {"$ref": "#/definitions/sha"},
    "differential_summary_sha256": {"$ref": "#/definitions/sha"},
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M00.ACC.OBS-SEMANTICS", "M00.ACC.RECONCILE", "M00.ACC.SPLIT-GUARD", "M00.ACC.BASELINE-GUARD", "M00.ACC.CONTRACT-LOCK", "M00.FAL.INSTRUMENTATION", "M00.STOP.MISSING-EVIDENCE"],
      "properties": {
        "M00.ACC.OBS-SEMANTICS": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]},
        "M00.ACC.RECONCILE": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]},
        "M00.ACC.SPLIT-GUARD": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]},
        "M00.ACC.BASELINE-GUARD": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]},
        "M00.ACC.CONTRACT-LOCK": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]},
        "M00.FAL.INSTRUMENTATION": {"oneOf": [{"type": "boolean"}, {"const": "UNVERIFIED"}]},
        "M00.STOP.MISSING-EVIDENCE": {"oneOf": [{"type": "boolean"}, {"const": "UNVERIFIED"}]}
      }
    },
    "criterion_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M00.ACC.OBS-SEMANTICS", "M00.ACC.RECONCILE", "M00.ACC.SPLIT-GUARD", "M00.ACC.BASELINE-GUARD", "M00.ACC.CONTRACT-LOCK", "M00.FAL.INSTRUMENTATION", "M00.STOP.MISSING-EVIDENCE"],
      "properties": {
        "M00.ACC.OBS-SEMANTICS": {"$ref": "#/definitions/criterion_evidence"},
        "M00.ACC.RECONCILE": {"$ref": "#/definitions/criterion_evidence"},
        "M00.ACC.SPLIT-GUARD": {"$ref": "#/definitions/criterion_evidence"},
        "M00.ACC.BASELINE-GUARD": {"$ref": "#/definitions/criterion_evidence"},
        "M00.ACC.CONTRACT-LOCK": {"$ref": "#/definitions/criterion_evidence"},
        "M00.FAL.INSTRUMENTATION": {"$ref": "#/definitions/criterion_evidence"},
        "M00.STOP.MISSING-EVIDENCE": {"$ref": "#/definitions/criterion_evidence"}
      }
    },
    "root_causes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_fixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criterion_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact_path", "artifact_sha256", "source_set_sha256", "protocol_lock_sha256", "fresh_evidence"],
      "properties": {
        "status": {
          "oneOf": [
            {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]},
            {"type": "boolean"}
          ]
        },
        "artifact_path": {"type": ["string", "null"], "pattern": "^/"},
        "artifact_sha256": {"oneOf": [{"$ref": "#/definitions/sha"}, {"type": "null"}]},
        "source_set_sha256": {"$ref": "#/definitions/sha"},
        "protocol_lock_sha256": {"$ref": "#/definitions/sha"},
        "fresh_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/evidence_artifact"}
        }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/definitions/sha"}
      }
    },
    "criterion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "criterion", "status", "source_set_sha256", "protocol_lock_sha256", "fresh_evidence"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "criterion": {
          "enum": ["M00.ACC.OBS-SEMANTICS", "M00.ACC.RECONCILE", "M00.ACC.SPLIT-GUARD", "M00.ACC.BASELINE-GUARD", "M00.ACC.CONTRACT-LOCK", "M00.FAL.INSTRUMENTATION", "M00.STOP.MISSING-EVIDENCE"]
        },
        "status": {
          "oneOf": [
            {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]},
            {"type": "boolean"}
          ]
        },
        "source_set_sha256": {"$ref": "#/definitions/sha"},
        "protocol_lock_sha256": {"$ref": "#/definitions/sha"},
        "fresh_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/evidence_artifact"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "criterion": {
                "enum": ["M00.ACC.OBS-SEMANTICS", "M00.ACC.RECONCILE", "M00.ACC.SPLIT-GUARD", "M00.ACC.BASELINE-GUARD", "M00.ACC.CONTRACT-LOCK"]
              }
            },
            "required": ["criterion"]
          },
          "then": {
            "properties": {
              "status": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE", "UNVERIFIED"]}
            }
          },
          "else": {
            "properties": {
              "status": {"type": "boolean"}
            }
          }
        }
      ]
    }
  }
}
