{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/shape-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rows"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape_id", "cluster_id", "tile_id", "dtype", "transpose_a", "transpose_b", "m", "n", "k", "batch", "cohort", "role", "selection_provenance", "source_sha256", "sealed_at"],
        "properties": {
          "shape_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "cluster_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "tile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
          "dtype": {"enum": ["f16", "bf16", "f32", "f64", "i8"]},
          "transpose_a": {"enum": ["N", "T"]},
          "transpose_b": {"enum": ["N", "T"]},
          "m": {"type": "integer", "minimum": 1},
          "n": {"type": "integer", "minimum": 1},
          "k": {"type": "integer", "minimum": 1},
          "batch": {"type": "integer", "minimum": 1},
          "cohort": {"enum": ["pilot", "development", "final_holdout"]},
          "role": {"enum": ["pilot", "development", "development_guidance", "development_judgment", "final_holdout"]},
          "selection_provenance": {"type": "string", "minLength": 1, "maxLength": 1024},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sealed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
        }
      }
    }
  }
}
