{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/generated-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "scenario_id", "invocation_id", "generation", "evaluator_mode", "shapes", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "scenario_id": {"enum": ["fixed_horizon", "early_stop", "checkpoint_resume", "adversarial_ledger"]},
    "invocation_id": {"type": "string", "pattern": "^invocation-[0-9]{4}$"},
    "generation": {"type": "integer", "minimum": 1},
    "evaluator_mode": {"enum": ["formula", "flat", "adversarial"]},
    "stage": {"enum": ["classify", "compile", "benchmark"]},
    "expected_outcome": {"enum": ["invalid", "duplicate", "compile_failed", "benchmark_failed", "partial", "complete"]},
    "shapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape_id", "factor", "role"],
        "properties": {
          "shape_id": {"type": "string", "pattern": "^cpu-fixture-[a-z0-9-]+$"},
          "factor": {"type": "number", "minimum": 0},
          "role": {"const": "non_comparative_fixture"}
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "config_id", "config"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^(g[0-9]{4}-c[0-9]{4}-[0-9a-f]{12}|p[0-5])$"},
          "config_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": ["a", "b", "c"],
            "properties": {
              "a": {"type": "number"},
              "b": {"type": "number"},
              "c": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
