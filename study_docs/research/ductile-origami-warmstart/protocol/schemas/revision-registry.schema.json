{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/revision-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "m00_source_set"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entries": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision_id", "kind", "object_id", "path", "materialized_sha256", "allowed_deviation_id"],
        "properties": {
          "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"},
          "kind": {"enum": ["parent_commit", "locked_commit", "imported_blob"]},
          "object_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "path": {
            "type": ["string", "null"],
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\-/]+$"
          },
          "materialized_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "allowed_deviation_id": {
            "enum": [null, "SPDX_ONLY", "M00_OBSERVER_TERMINATION", "M00_DEEP_MERGE", "M00_HAMMING_LAZY_PANDAS", "M00_LAZY_SCIPY", "M00_NOOP_TQDM"]
          }
        }
      }
    },
    "m00_source_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "path_count"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
