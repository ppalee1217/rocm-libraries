{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/run-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "scenario_id", "run_kind", "observer_mode", "execution_kind", "arm", "complete", "resume_from_sha256", "shape_ids", "seed", "command_argv", "cwd", "parent_commit", "locked_ductile_object", "contract_sha256", "effective_contract_sha256", "source_set_sha256", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "scenario_id": {"enum": ["fixed_horizon", "early_stop", "checkpoint_resume", "adversarial_ledger"]},
    "run_kind": {"enum": ["continuous", "interrupted", "resumed", "adversarial_continuous", "adversarial_interrupted", "adversarial_resumed"]},
    "observer_mode": {"enum": ["off", "on"]},
    "execution_kind": {"const": "deterministic_cpu_fixture"},
    "arm": {"const": "m00-observability"},
    "complete": {"type": "boolean"},
    "resume_from_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "shape_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^cpu-fixture-[a-z0-9-]+$"}
    },
    "seed": {"type": "integer", "minimum": 0},
    "command_argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "cwd": {"type": "string", "pattern": "^/"},
    "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "locked_ductile_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_sha256": {"$ref": "#/definitions/sha"},
    "effective_contract_sha256": {"$ref": "#/definitions/sha"},
    "source_set_sha256": {"$ref": "#/definitions/sha"},
    "started_at": {"$ref": "#/definitions/timestamp"},
    "finished_at": {"$ref": "#/definitions/timestamp"}
  },
  "definitions": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
