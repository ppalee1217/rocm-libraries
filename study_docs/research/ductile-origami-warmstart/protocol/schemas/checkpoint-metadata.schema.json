{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/checkpoint-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkpoint_path", "checkpoint_sha256", "projection", "python_random_state_sha256", "numpy_random_state_sha256", "seed_sequence_state", "protocol_lineage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "checkpoint_path": {"const": "checkpoints/ga.checkpoint"},
    "checkpoint_sha256": {"$ref": "#/definitions/sha"},
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "legacy_n_evals", "population_size", "decay_mode", "champion_hash", "champion_fitness_sha256"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "legacy_n_evals": {"type": "integer", "minimum": 0},
        "population_size": {"type": "integer", "minimum": 1},
        "decay_mode": {"enum": ["none", "large_space", "low_diversity"]},
        "champion_hash": {"$ref": "#/definitions/sha"},
        "champion_fitness_sha256": {"$ref": "#/definitions/sha"}
      }
    },
    "python_random_state_sha256": {"$ref": "#/definitions/sha"},
    "numpy_random_state_sha256": {"$ref": "#/definitions/sha"},
    "seed_sequence_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entropy", "spawn_key", "pool_size", "n_children_spawned"],
      "properties": {
        "entropy": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
          ]
        },
        "spawn_key": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "pool_size": {"type": "integer", "minimum": 1},
        "n_children_spawned": {"type": "integer", "minimum": 0}
      }
    },
    "protocol_lineage": {"$ref": "#/definitions/protocol_lineage"}
  },
  "definitions": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "scenario_id", "seed", "n_gen", "split_generation", "contract_sha256", "effective_contract_sha256", "split_registry_sha256", "baseline_registry_sha256", "revision_registry_sha256", "protocol_lock_sha256", "source_set_sha256"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "scenario_id": {"enum": ["fixed_horizon", "early_stop", "checkpoint_resume", "adversarial_ledger"]},
        "seed": {"type": "integer", "minimum": 0},
        "n_gen": {"type": "integer", "minimum": 1},
        "split_generation": {"type": ["integer", "null"], "minimum": 1},
        "contract_sha256": {"$ref": "#/definitions/sha"},
        "effective_contract_sha256": {"$ref": "#/definitions/sha"},
        "split_registry_sha256": {"$ref": "#/definitions/sha"},
        "baseline_registry_sha256": {"$ref": "#/definitions/sha"},
        "revision_registry_sha256": {"$ref": "#/definitions/sha"},
        "protocol_lock_sha256": {"$ref": "#/definitions/sha"},
        "source_set_sha256": {"$ref": "#/definitions/sha"}
      }
    }
  }
}
