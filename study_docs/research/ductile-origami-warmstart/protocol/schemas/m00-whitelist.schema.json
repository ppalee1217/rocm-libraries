{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/m00-whitelist.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parent_commit", "implementation_paths", "conditional_report_paths", "protected_paths", "planning_paths", "source_set_paths", "generated_roots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_paths": {"$ref": "#/definitions/path_set"},
    "conditional_report_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/definitions/path"}
    },
    "protected_paths": {
      "type": "array",
      "minItems": 4,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/path"}
    },
    "planning_paths": {"$ref": "#/definitions/path_set"},
    "source_set_paths": {"$ref": "#/definitions/path_set"},
    "generated_roots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/path"}
    }
  },
  "definitions": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\-/]+$"},
    "path_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/path"}
    }
  }
}
