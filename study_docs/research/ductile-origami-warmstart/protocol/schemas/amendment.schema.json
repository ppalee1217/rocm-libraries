{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amd.example/m00/amendment.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "sequence", "protocol_version", "parent_line_sha256", "parent_effective_contract_sha256", "base_contract_sha256", "owner", "occurred_at", "reason", "decision_provenance", "operations", "effective_contract_sha256"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "genesis"},
        "sequence": {"const": 0},
        "protocol_version": {"$ref": "#/definitions/version"},
        "parent_line_sha256": {"type": "null"},
        "parent_effective_contract_sha256": {"type": "null"},
        "base_contract_sha256": {"$ref": "#/definitions/sha"},
        "owner": {"type": "string", "minLength": 1},
        "occurred_at": {"$ref": "#/definitions/timestamp"},
        "reason": {"type": "string", "minLength": 1},
        "decision_provenance": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "maxItems": 0},
        "effective_contract_sha256": {"$ref": "#/definitions/sha"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "sequence", "protocol_version", "parent_line_sha256", "parent_effective_contract_sha256", "base_contract_sha256", "amendment_sha256", "owner", "occurred_at", "reason", "decision_provenance", "changed_keys", "operations", "effective_contract_sha256"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "amendment"},
        "sequence": {"type": "integer", "minimum": 1},
        "protocol_version": {"$ref": "#/definitions/version"},
        "parent_line_sha256": {"$ref": "#/definitions/sha"},
        "parent_effective_contract_sha256": {"$ref": "#/definitions/sha"},
        "base_contract_sha256": {"$ref": "#/definitions/sha"},
        "amendment_sha256": {"$ref": "#/definitions/sha"},
        "owner": {"type": "string", "minLength": 1},
        "occurred_at": {"$ref": "#/definitions/timestamp"},
        "reason": {"type": "string", "minLength": 1},
        "decision_provenance": {"type": "string", "minLength": 1},
        "changed_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/path"}
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/operation"}
        },
        "effective_contract_sha256": {"$ref": "#/definitions/sha"}
      }
    }
  ],
  "definitions": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "path": {"type": "string", "pattern": "^/(study|platform|revisions|data_roles|baseline|measurement|search|guidance|statistics|criteria|correctness|locks)(/([^/~]|~0|~1)+)+$"},
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": {"enum": ["add", "replace"]},
            "path": {"$ref": "#/definitions/path"},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path"],
          "properties": {
            "op": {"const": "remove"},
            "path": {"$ref": "#/definitions/path"}
          }
        }
      ]
    }
  }
}
